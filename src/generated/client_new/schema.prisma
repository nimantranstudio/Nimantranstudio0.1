generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client_new"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String?   @unique
  name             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  isMobileVerified Boolean   @default(false)
  mobileNumber     String    @unique
  role             String    @default("user")
  status           String    @default("active")
  orders           Order[]
  weddings         Wedding[]

  @@map("User")
}

model OTPRequest {
  id           String   @id @default(cuid())
  mobileNumber String
  otpHash      String
  expiresAt    DateTime
  isUsed       Boolean  @default(false)
  attemptCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("OTPRequest")
}

model Bundle {
  id                String   @id @default(cuid())
  themeId           String?
  BundleName        String
  isActive          Boolean  @default(true)
  isPopular         Boolean  @default(false)
  bundleDescription String?
  createdDate       DateTime @default(now())
  modifiedDate      DateTime @updatedAt

  // UI Assets (preserving these as they are needed for preview)
  previewImages String?
  thumbnailUrl  String?
  itemImages    String?

  themeRef       Theme?          @relation(fields: [themeId], references: [id])
  bundleItems    BundleItem[]
  orders         Order[]
  bundleInvoices BundleInvoice[]

  @@map("Bundle")
}

model BundleItem {
  id           String   @id @default(cuid())
  bundleId     String
  eventId      String
  templateName String
  templatePath String
  createdDate  DateTime @default(now())
  modifiedDate DateTime @updatedAt

  bundle Bundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id])

  @@map("BundleItems")
}

model Event {
  id           String   @id @default(cuid())
  eventName    String
  createdDate  DateTime @default(now())
  modifiedDate DateTime @updatedAt

  bundleItems BundleItem[]

  @@map("Event")
}

model Order {
  id          String   @id @default(cuid())
  userId      String
  bundleId    String
  totalAmount Float
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bundle      Bundle   @relation(fields: [bundleId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@map("Order")
}

model Theme {
  id            String    @id @default(cuid())
  name          String
  description   String?
  thumbnailUrl  String?
  previewImages String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isBestSeller  Boolean   @default(false)
  isPopular     Boolean   @default(false)
  bundles       Bundle[]
  weddings      Wedding[]

  @@map("Theme")
}

model Wedding {
  id                String         @id @default(cuid())
  slug              String?        @unique
  ownerId           String
  themeId           String
  groomName         String
  brideName         String
  groomParents      String?
  brideParents      String?
  rsvpContact       String?
  rsvpDeadline      DateTime?
  invitationMessage String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  events            WeddingEvent[]
  rsvps             RSVP[]
  owner             User           @relation(fields: [ownerId], references: [id])
  theme             Theme          @relation(fields: [themeId], references: [id])

  @@map("Wedding")
}

model WeddingEvent {
  id              String   @id @default(cuid())
  weddingId       String
  name            String
  date            String
  time            String
  venue           String
  mapLink         String?
  description     String?
  eventType       String?
  rsvpDeadline    String?
  allowCompanions Boolean  @default(true)
  collectDietary  Boolean  @default(false)
  maxGuests       Int      @default(4)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  wedding         Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@map("WeddingEvent")
}

model RSVP {
  id         String   @id @default(cuid())
  weddingId  String
  guestName  String
  phone      String?
  adultCount Int      @default(1)
  childCount Int      @default(0)
  attending  Boolean  @default(true)
  status     String   @default("pending")
  dietary    String?
  message    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  wedding    Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@map("RSVP")
}

model Package {
  id                String   @id @default(cuid())
  name              String
  price             Int
  level             Int
  allowedItems      String
  isActive          Boolean  @default(true)
  whatYouGet        String?
  productHighlights String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bundleInvoices BundleInvoice[]

  @@map("Package")
}

model BundleInvoice {
  id                     String   @id @default(cuid())
  bundleId               String
  packageId              String
  isDisplay              Boolean  @default(false)
  invitationDesignSuite  Float    @default(0)
  rsvpManagementTracking Float    @default(0)
  guestDashboard         Float    @default(0)
  totalWeddingSuiteValue Float    @default(0)
  discount               Float    @default(0)
  discountedPrice        Float    @default(0)
  finalSellingPrice      Float    @default(0)
  createdDate            DateTime @default(now())
  modifiedDate           DateTime @updatedAt

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([bundleId, packageId])
  @@map("BundleInvoice")
}

model SiteSetting {
  key   String @id
  value String // Can store JSON

  @@map("SiteSetting")
}
