// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  weddings  Wedding[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Wedding {
  id                String   @id @default(cuid())
  ownerId           String
  owner             User     @relation(fields: [ownerId], references: [id])
  
  themeId           String
  groomName         String
  brideName         String
  groomParents      String?
  brideParents      String?
  rsvpContact       String?
  rsvpDeadline      DateTime?
  invitationMessage String?
  
  events            Event[]
  rsvps             RSVP[]
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Event {
  id          String   @id @default(cuid())
  weddingId   String
  wedding     Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  
  name        String
  date        String
  time        String
  venue       String
  mapLink     String?
  description String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RSVP {
  id         String   @id @default(cuid())
  weddingId  String
  wedding    Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  
  guestName  String
  adultCount Int      @default(1)
  childCount Int      @default(0)
  attending  Boolean  @default(true)
  message    String?
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
