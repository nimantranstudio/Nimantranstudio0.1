generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
  binaryTargets = ["native", "darwin-arm64", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String?   @unique
  name             String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  isMobileVerified Boolean   @default(false)
  mobileNumber     String    @unique
  role             String    @default("user")
  status           String    @default("active")
  orders           Order[]
  weddings         Wedding[]

  @@map("User")
}

model OTPRequest {
  id           String   @id @default(cuid())
  mobileNumber String
  otpHash      String
  expiresAt    DateTime
  isUsed       Boolean  @default(false)
  attemptCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@map("OTPRequest")
}

model Bundle {
  id                 String   @id @default(cuid())
  name               String
  whatsappPrice      Int      @default(0)
  printablePrice     Int      @default(0)
  completePrice      Int      @default(0)
  isPopular          Boolean  @default(false)
  theme              String   @default("default")
  description        String?  @db.Text
  isActive           Boolean  @default(true)
  themeId            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  previewImages      String?  @db.Text
  thumbnailUrl       String?
  itemImages         String?  @db.Text
  themeRef           Theme?   @relation(fields: [themeId], references: [id])
  orders             Order[]
  bundleItems        BundleItem[]

  @@map("Bundle")
}

model BundleItem {
  id            String   @id @default(cuid())
  bundleId      String
  eventType     String
  templateName  String
  templateFile  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bundle        Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@map("BundleItems")
}

model Order {
  id          String   @id @default(cuid())
  userId      String
  bundleId    String
  totalAmount Float
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bundle      Bundle   @relation(fields: [bundleId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@map("Order")
}

model Theme {
  id            String    @id @default(cuid())
  name          String
  description   String?
  thumbnailUrl  String?
  previewImages String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isBestSeller  Boolean   @default(false)
  isPopular     Boolean   @default(false)
  bundles       Bundle[]
  weddings      Wedding[]

  @@map("Theme")
}

model Wedding {
  id                String    @id @default(cuid())
  ownerId           String
  themeId           String
  groomName         String
  brideName         String
  groomParents      String?
  brideParents      String?
  rsvpContact       String?
  rsvpDeadline      DateTime?
  invitationMessage String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  events            Event[]
  rsvps             RSVP[]
  owner             User      @relation(fields: [ownerId], references: [id])
  theme             Theme     @relation(fields: [themeId], references: [id])

  @@map("Wedding")
}

model Event {
  id              String   @id @default(cuid())
  weddingId       String
  name            String
  date            String
  time            String
  venue           String
  mapLink         String?
  description     String?
  eventType       String?
  rsvpDeadline    String?
  allowCompanions Boolean  @default(true)
  collectDietary  Boolean  @default(false)
  maxGuests       Int      @default(4)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  wedding         Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@map("Event")
}

model RSVP {
  id         String   @id @default(cuid())
  weddingId  String
  guestName  String
  phone      String?
  adultCount Int      @default(1)
  childCount Int      @default(0)
  attending  Boolean  @default(true)
  status     String   @default("pending")
  dietary    String?
  message    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  wedding    Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  @@map("RSVP")
}

model Package {
  id           String   @id @default(cuid())
  name         String
  price        Int
  level        Int
  allowedItems String   @db.Text
  isActive          Boolean  @default(true)
  whatYouGet        String?  @db.Text
  productHighlights String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("Package")
}
