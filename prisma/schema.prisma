generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  weddings  Wedding[]
}

model Wedding {
  id                String    @id @default(cuid())
  ownerId           String
  themeId           String
  groomName         String
  brideName         String
  groomParents      String?
  brideParents      String?
  rsvpContact       String?
  rsvpDeadline      DateTime?
  invitationMessage String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  events            Event[]
  rsvps             RSVP[]
  owner             User      @relation(fields: [ownerId], references: [id])
}

model Event {
  id              String   @id @default(cuid())
  weddingId       String
  name            String
  date            String
  time            String
  venue           String
  mapLink         String?
  description     String?
  eventType       String?
  rsvpDeadline    String?
  allowCompanions Boolean  @default(true)
  collectDietary  Boolean  @default(false)
  maxGuests       Int      @default(4)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  wedding         Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}

model RSVP {
  id         String   @id @default(cuid())
  weddingId  String
  guestName  String
  phone      String?
  adultCount Int      @default(1)
  childCount Int      @default(0)
  attending  Boolean  @default(true)
  status     String   @default("pending")
  dietary    String?
  message    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  wedding    Wedding  @relation(fields: [weddingId], references: [id], onDelete: Cascade)
}
